rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function member(space) {
      return isAuth() && request.auth.uid in
        get(/databases/$(database)/documents/spaces/$(space)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow write: if isAuth() && request.auth.uid == uid;
      match /{document=**} { allow read, write: if false; }
    }

    match /spaces/{space} {
      allow read: if member(space);
      allow create: if isAuth();
      allow update: if member(space) || (isAuth() && request.resource.data.memberIds.hasAny([request.auth.uid]));

      match /moments/{id} {
        allow read, write: if member(space);
      }
      match /countdowns/{id} {
        allow read, write: if member(space);
      }
      match /questions/{day}/answers/{uid} {
        allow read: if member(space) && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/spaces/$(space)/questions/$(day)/answers/$(request.auth.uid)));
        allow write: if member(space) && request.auth.uid == uid;
      }
    }

    match /invites/{code} {
      allow read, write: if isAuth();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
